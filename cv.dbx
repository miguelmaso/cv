\DeclareDatamodelFields[type=field,datatype=literal]{financing}
\DeclareDatamodelFields[type=list,datatype=name]{pi}
\DeclareDatamodelEntrytypes{project}
\DeclareDatamodelEntryfields[project]{title,date,pi,financing}
\DeclareDatamodelConstraints[project]{
  \constraint[type=mandatory]{\constraintfield{title}}
  \constraint[type=mandatory]{\constraintfield{date}}
  \constraint[type=mandatory]{\constraintfield{pi}}
  \constraint[type=mandatory]{\constraintfield{financing}}
}

\NewBibliographyString{pi}
\NewBibliographyString{period}
\NewBibliographyString{financing}

\DefineBibliographyStrings{english}{
  pi        = {PI},
  period    = {Period},
  financing = {Financing entity}
}
\DefineBibliographyStrings{spanish}{
  pi        = {IP},
  period    = {Periodo},
  financing = {Entidad financiadora}
}
\DefineBibliographyStrings{catalan}{
  pi        = {IP},
  period    = {Període},
  financing = {Entitat finançadora}
}

\DeclareBibliographyDriver{project}{%
  \printfield{title}\par
  \printtext{\bibstring{financing}: }\printfield{financing}\par
  \printtext{\bibstring{period}: }\printdate\par
  \printtext{\bibstring{pi}: }\printnames{pi}%
}
